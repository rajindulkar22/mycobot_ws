<?xml version="1.1"?>

<robot  xmlns:xacro="http://www.ros.org/wiki/xacro" name="mycobot_280jn_sim" >

<!--
    Approximate box inertia for initial simulation.
    These values are simulation estimates and should later be replaced
    with CAD-derived mass, centre-of-mass and inertia properties.
  -->
  <xacro:macro

    name="box_inertial"

    params="mass x y z">

    <inertial>

      <origin xyz="0 0 0" rpy="0 0 0"/>

      <mass value="${mass}"/>

      <inertia

        ixx="${mass * (y * y + z * z) / 12.0}"

        ixy="0.0"

        ixz="0.0"

        iyy="${mass * (x * x + z * z) / 12.0}"

        iyz="0.0"

        izz="${mass * (x * x + y * y) / 12.0}"

      />

    </inertial>

  </xacro:macro>

  <!-- Explicit colours keep the robot readable when Collada materials are
       ignored by Gazebo / Ogre2. -->
  <material name="mycobot_light_gray">
    <color rgba="0.72 0.74 0.76 1.0"/>
  </material>
  <material name="mycobot_dark_gray">
    <color rgba="0.16 0.18 0.20 1.0"/>
  </material>

  <link name="world"/>

  <joint name="world_to_joint1" type="fixed">
    <parent link="world"/>
    <child link="joint1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>



  <link name="joint1">

    <xacro:box_inertial mass="1.20" x="0.16" y="0.16" z="0.18"/>

    <visual>
