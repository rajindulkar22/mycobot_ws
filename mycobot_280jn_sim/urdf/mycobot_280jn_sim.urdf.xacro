<joint name="gripper_controller" type="revolute">

    <axis xyz="0 0 1"/>

    <limit effort="5.0" lower="-0.74" upper="0.15" velocity="0.8"/>

    <dynamics damping="0.50" friction="0.20"/>

    <parent link="gripper_base"/>

    <child link="gripper_left3"/>

    <origin xyz= "-0.012 0.005 0" rpy = "0 0 0"/> 

  </joint>

  <joint name="gripper_base_to_gripper_left2" type="revolute">

    <axis xyz="0 0 1"/>

    <limit effort = "1000.0" lower = "-0.8" upper = "0.5" velocity = "0.8"/>

    <dynamics damping="0.50" friction="0.20"/>

    <parent link="gripper_base"/>

    <child link="gripper_left2"/>

    <origin xyz= "-0.005 0.027 0" rpy = "0 0 0"/> 

    <mimic
      joint="gripper_controller"
      multiplier="1.0"
      offset="0.0"/>

  </joint>

  <joint name="gripper_left3_to_gripper_left1" type="revolute">

    <axis xyz="0 0 1"/>

    <limit effort = "1000.0" lower = "-0.5" upper = "0.5" velocity = "0.8"/>

    <dynamics damping="0.50" friction="0.20"/>

    <parent link="gripper_left3"/>

    <child link="gripper_left1"/>

    <origin xyz= "-0.027 0.016 0" rpy = "0 0 0"/> 

    <mimic
      joint="gripper_controller"
      multiplier="-1.0"
      offset="0.0"/>

  </joint>

  <joint name="gripper_base_to_gripper_right3" type="revolute">

    <axis xyz="0 0 1"/>

    <limit effort = "1000.0" lower = "-0.15" upper = "0.7" velocity = "0.8"/>

    <dynamics damping="0.50" friction="0.20"/>

    <parent link="gripper_base"/>

    <child link="gripper_right3"/>

    <origin xyz= "0.012 0.005 0" rpy = "0 0 0"/> 

    <mimic
      joint="gripper_controller"
      multiplier="-1.0"
      offset="0.0"/>

  </joint>

  <joint name="gripper_base_to_gripper_right2" type="revolute">

    <axis xyz="0 0 1"/>

    <limit effort = "1000.0" lower = "-0.5" upper = "0.8" velocity = "0.8"/>

    <dynamics damping="0.50" friction="0.20"/>

    <parent link="gripper_base"/>

    <child link="gripper_right2"/>

    <origin xyz= "0.005 0.027 0" rpy = "0 0 0"/> 

    <mimic
      joint="gripper_controller"
      multiplier="-1.0"
      offset="0.0"/>

  </joint>

  <joint name="gripper_right3_to_gripper_right1" type="revolute">

    <axis xyz="0 0 1"/>

    <limit effort = "1000.0" lower = "-0.5" upper = "0.5" velocity = "0.8"/>

    <dynamics damping="0.50" friction="0.20"/>

    <parent link="gripper_right3"/>

    <child link="gripper_right1"/>

    <origin xyz= "0.027 0.016 0" rpy = "0 0 0"/> 

    <mimic
      joint="gripper_controller"
      multiplier="1.0"
      offset="0.0"/>

      <!--
    Tool Centre Point for manipulation.

    The TCP is approximately centred between the two fingertip contact
    regions. It remains fixed relative to gripper_base while the finger
    joints open and close symmetrically.
  -->
 
  </joint>

    <!--
    Tool Centre Point for manipulation.

    The TCP is approximately centred between the two fingertip contact
    regions. It remains fixed relative to gripper_base while the finger
    joints open and close symmetrically.
  -->
  <link name="gripper_tcp"/>

  <joint name="gripper_base_to_tcp" type="fixed">
    <parent link="gripper_base"/>
    <child link="gripper_tcp"/>

    <origin
      xyz="0.0 0.0214 0.0003" rpy="0 0 0"/>
  </joint>

  <!-- ROS 2 Control exposes the six arm joints and the adaptive gripper.
       The arm starts in its neutral zero configuration. Only the gripper's
       driving joint accepts commands; Gazebo derives the five follower joint
       positions from their URDF mimic relationships. -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint2_to_joint1">
      <command_interface name="position">
        <param name="min">-2.9321</param>
        <param name="max">2.9321</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint3_to_joint2">
      <command_interface name="position">
        <param name="min">-2.4434</param>
        <param name="max">2.4434</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint4_to_joint3">
      <command_interface name="position">
        <param name="min">-2.6179</param>
        <param name="max">2.6179</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint5_to_joint4">
      <command_interface name="position">
        <param name="min">-2.6179</param>
        <param name="max">2.6179</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint6_to_joint5">
      <command_interface name="position">
        <param name="min">-2.7052</param>
        <param name="max">2.7925</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint6output_to_joint6">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_controller">
      <command_interface name="position">
        <param name="min">-0.74</param>
        <param name="max">0.15</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Followers are driven by gz_ros2_control mimic params (not Gazebo's
         URDF <mimic> joints, which create conflicting *_mimic joints). -->
    <joint name="gripper_base_to_gripper_left2">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">1.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_left3_to_gripper_left1">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">-1.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_base_to_gripper_right3">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">-1.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_base_to_gripper_right2">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">-1.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_right3_to_gripper_right1">
      <param name="mimic">gripper_controller</param>
      <param name="multiplier">1.0</param>
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Match pick_cube friction so finger–cube contacts grip reliably. -->
  <gazebo reference="gripper_base">
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>75000</kp>
    <kd>10</kd>
  </gazebo>
  <gazebo reference="gripper_left1">
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>75000</kp>
    <kd>10</kd>
  </gazebo>
  <gazebo reference="gripper_left2">
    <mu1>2.5</mu1>
    <mu2>2.5</mu2>
    <kp>75000</kp>
    <kd>10</kd>
