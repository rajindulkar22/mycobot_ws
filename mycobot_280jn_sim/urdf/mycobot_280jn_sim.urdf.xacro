        <mesh filename="package://mycobot_description/urdf/mycobot_280_jn/joint1_jet.dae"/>
      </geometry>
      <origin xyz="0.0 0 0" rpy="0 0 3.14159"/>
      <material name="mycobot_light_gray"/>
    </visual>

    <collision>

      <geometry>

<!--- 0.0 0 -0.04  1.5708 3.14159-->
