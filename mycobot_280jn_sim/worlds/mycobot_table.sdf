<?xml version="1.0"?>

<sdf version="1.9">
  <world name="mycobot_world">

    <physics name="physics" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
      <engine>
        <filename>ignition-physics-dartsim-plugin</filename>
      </engine>
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>

      <pose>
        0 0 10 0 0 0
      </pose>

      <diffuse>
        0.8 0.8 0.8 1
      </diffuse>

      <specular>
        0.2 0.2 0.2 1
      </specular>

      <direction>
        -0.5 0.1 -0.9
      </direction>
    </light>

    <model name="ground_plane">
      <static>true</static>

      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="work_table">
      <static>true</static>

      <!--
        Table height: 0.40 m
        Tabletop thickness: 0.05 m
        Tabletop centre: 0.375 m
      -->
      <pose>
        0 0 0 0 0 0
      </pose>

      <link name="tabletop">
        <pose>
          0 0 0.375 0 0 0
        </pose>

        <collision name="tabletop_collision">
          <geometry>
            <box>
              <size>0.8 0.6 0.05</size>
            </box>
          </geometry>
        </collision>

        <visual name="tabletop_visual">
          <geometry>
            <box>
              <size>0.8 0.6 0.05</size>
            </box>
          </geometry>

          <material>
            <ambient>0.25 0.15 0.08 1</ambient>
            <diffuse>0.45 0.25 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

        <!-- Dynamic cube used for grasping experiments -->
    <model name="pick_cube">
      <static>false</static>

      <!--
        Table surface: 0.400 m
        Cube size:      0.025 m (25 mm — small target for adaptive gripper)
        Cube centre:    0.400 + 0.0125 = 0.4125 m
      -->
      <pose>0.20 0.00 0.4125 0 0 0</pose>

      <link name="cube_link">

        <inertial>
          <mass>0.05</mass>

          <inertia>
            <ixx>0.00000521</ixx>
            <iyy>0.00000521</iyy>
            <izz>0.00000521</izz>

            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>

        <collision name="cube_collision">
          <geometry>
            <box>
              <size>0.025 0.025 0.025</size>
            </box>
          </geometry>

          <surface>
            <friction>
              <ode>
                <mu>2.5</mu>
                <mu2>2.5</mu2>
              </ode>
            </friction>

            <contact>
              <ode>
                <kp>75000.0</kp>
                <kd>10.0</kd>
              </ode>
            </contact>
          </surface>
        </collision>

        <visual name="cube_visual">
          <geometry>
            <box>
              <size>0.025 0.025 0.025</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.05 0.05 1</ambient>
            <diffuse>0.9 0.08 0.08 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>

      </link>
    </model>

  </world>
</sdf>